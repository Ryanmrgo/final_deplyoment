#!/bin/bash
# Copy this file and replace placeholders with your actual keys
# Then rename to .env.local

# ========================================
# CLERK AUTHENTICATION
# ========================================
# Get these from https://clerk.com/docs/dashboard/api-keys-and-credentials

# Your public key (safe to expose in browser)


# Your secret key (keep private!)

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_ZmVhc2libGUtZ29vc2UtNjMuY2xlcmsuYWNjb3VudHMuZGV2JA
CLERK_SECRET_KEY=sk_test_fhk2h9gY9EC5cEo17ltCdIzTIOvkGqMFdiHEadXTxY
# Webhook secret for syncing users from Clerk to MongoDB
CLERK_WEBHOOK_SECRET=whsec_9+fe0KYTjBsELPJfClyWGjdzjCw2Av2T

# URLs for sign in/up (these are already set in .env.local)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/auth/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/auth/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard/onboarding
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard/onboarding

# ========================================
# MONGODB
# ========================================
# Get connection string from https://cloud.mongodb.com

# Format: mongodb+srv://username:password@cluster-name.mongodb.net
MONGODB_URI=mongodb+srv://REPLACE_USERNAME:REPLACE_PASSWORD@your-cluster.mongodb.net

# ========================================
# LESSON UPLOAD LIMITS
# ========================================
# Server-side max lesson upload size in MB (default: 500)
LESSON_MAX_UPLOAD_MB=500

# Client-side display/validation value shown in upload forms (should match server value)
NEXT_PUBLIC_LESSON_MAX_UPLOAD_MB=500

# ========================================
# HOW TO GET YOUR KEYS
# ========================================
# 
# 1. CLERK KEYS:
#    - Go to https://clerk.com/docs/dashboard/api-keys-and-credentials
#    - Copy "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY" 
#    - Copy "CLERK_SECRET_KEY"
#
# 2. CLERK WEBHOOK SECRET:
#    - Go to Dashboard → Webhooks
#    - Create endpoint: https://yourdomain.com/api/webhooks/clerk
#    - Copy the signing secret
#    - (For local dev, use ngrok or similar)
#
# 3. MONGODB URI:
#    - Go to https://cloud.mongodb.com
#    - Select your cluster
#    - Click "Connect" → "Drivers"
#    - Copy the connection string
#    - Replace <username>, <password>, and cluster name
#
# ========================================
